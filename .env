# BalanceVault configuration. Real environment variables override these values.
PORT=8080
SESSION_TTL_MINUTES=30
# false because the app is served over plain HTTP; set true only behind HTTPS.
COOKIE_SECURE=false
INVITE_TTL_HOURS=72

# First admin, seeded on first start only (never overwrites an existing admin).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=T@pestry@321

# PostgreSQL connection. Left empty on purpose: docker-compose.yml supplies them for local runs.
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# Password for the local docker-compose Postgres container only (development value).
LOCAL_PG_PASSWORD=dev-local-pg-change-me
